
# ============================================================
# MARKETPLACECOMPONENTES
# FASE 10G.3 - CONFIGURACION PARA DESARROLLADORES
# ============================================================

# SEGURIDAD DJANGO
# Cada desarrollador debe generar su propia clave.
DJANGO_SECRET_KEY=REEMPLAZAR_CON_CLAVE_SEGURA_PROPIA

# MOTOR DE BASE DE DATOS
# Opciones: mysql / sqlite
DJANGO_DB_ENGINE=mysql

# CONFIGURACION MYSQL DE DESARROLLO
# No utilizar credenciales de produccion.
MYSQL_DB_NAME=marketplace_componentes_dev
MYSQL_DB_USER=marketplace_dev
MYSQL_DB_PASSWORD=REEMPLAZAR_CON_PASSWORD_LOCAL
MYSQL_DB_HOST=127.0.0.1
MYSQL_DB_PORT=3306
